APP_ENV=demo
MAX_MODE=mock
PORT=3100
PUBLIC_APP_URL=http://localhost:8080
DATABASE_URL=postgres://salon:salon_local_only@localhost:5432/salon
REDIS_URL=redis://localhost:6380
# Только синтетический секрет демо. Настоящий токен сюда не копировать.
MAX_BOT_TOKEN=demo-only-synthetic-token
MAX_BOT_NAME=salons_demo_bot
MAX_WEBHOOK_SECRET=demo-webhook-secret
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_GLOBAL_RPS=25
MAX_DIALOG_RPS=1
AUTH_MAX_AGE_SECONDS=3600
AUTH_FUTURE_SKEW_SECONDS=60
# Сессия продлевается, пока человек работает, и жёстко заканчивается по SESSION_ABSOLUTE_SECONDS
SESSION_IDLE_SECONDS=3600
SESSION_ABSOLUTE_SECONDS=43200
MEDIA_ROOT=./media
BOOKING_HORIZON_DAYS=30
SLOT_STEP_MINUTES=15
POSTGRES_PASSWORD=salon_local_only
POSTGRES_RUNTIME_PASSWORD=salon_runtime_local_only
HTTP_PORT=8080
