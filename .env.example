APP_ENV=demo
MAX_MODE=mock
PORT=3100
PUBLIC_APP_URL=http://localhost:8080
DATABASE_URL=postgres://salon:salon_local_only@localhost:5432/salon
REDIS_URL=redis://localhost:6380
# Только синтетический секрет демо. Настоящий токен сюда не копировать.
MAX_BOT_TOKEN=demo-only-synthetic-token
MAX_BOT_NAME=salons_demo_bot
MAX_WEBHOOK_SECRET=demo-webhook-secret
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_GLOBAL_RPS=25
MAX_DIALOG_RPS=1
AUTH_MAX_AGE_SECONDS=3600
AUTH_FUTURE_SKEW_SECONDS=60
# Сессия продлевается, пока человек работает, и жёстко заканчивается по SESSION_ABSOLUTE_SECONDS
SESSION_IDLE_SECONDS=3600
SESSION_ABSOLUTE_SECONDS=43200
MEDIA_ROOT=./media
BOOKING_HORIZON_DAYS=30
SLOT_STEP_MINUTES=15
POSTGRES_PASSWORD=salon_local_only
POSTGRES_RUNTIME_PASSWORD=salon_runtime_local_only
HTTP_PORT=8080
SALON_DISCOVERY_SEARCH_ENABLED=true
SALON_DISCOVERY_MAP_ENABLED=true
SALON_DISCOVERY_EDITOR_ENABLED=true
# OpenFreeMap — бесплатные стили карты без ключа; можно заменить своим MapLibre style URL.
SALON_DISCOVERY_MAP_STYLE_LIGHT_URL=https://tiles.openfreemap.org/styles/positron
SALON_DISCOVERY_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/fiord
# Nominatim включён по умолчанию: поиск запускается только вручную, сервер кэширует ответы
# и глобально ограничивает обращения одним запросом в секунду. Для Geoapify выберите провайдера
# и добавьте бесплатный API-ключ; коммерческие условия и лимиты проверьте перед запуском.
SALON_DISCOVERY_GEOCODER_ENABLED=true
SALON_DISCOVERY_GEOCODER_PROVIDER=nominatim
SALON_DISCOVERY_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
SALON_DISCOVERY_GEOAPIFY_API_KEY=
# Список MAX user ID через запятую для проверки геоточек и ссылок.
PLATFORM_ADMIN_MAX_IDS=
